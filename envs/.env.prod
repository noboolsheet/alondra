#--- DOCKER (perfil prod: sitio VIVO del cliente, público por Caddy) ---#
DOCKER_PROFILE="prod"
# Red COMPARTIDA del servidor, no una propia. Antes era "alondra_network", con lo
# que Caddy no podía alcanzar el contenedor por su nombre.
DOCKER_NETWORK="noboolsheet_network"
# Loopback a propósito: el tráfico público entra por el 443 de Caddy, que alcanza
# el contenedor por su nombre dentro de la red Docker. Publicarlo en 0.0.0.0
# dejaría el 4232 abierto en la IP pública de vibox sin ninguna necesidad.
# `expose.sh` (Tailscale Funnel) también funciona contra localhost.
DOCKER_IFACE="127.0.0.1"

#--- ALONDRA (SPA Vite + server Express en un solo contenedor) ---#
DOCKER_ALONDRA_APP_DDNS="alondra.app"
ALONDRA_APP_EPORT="4232"
ALONDRA_APP_IPORT="3000"
ALONDRA_APP_IFACE="${DOCKER_IFACE}"
# Destinatario de los formularios. El remitente (GMAIL_USER) y la App Password de
# Gmail viven en web/.env.prod (gitignored).
ALONDRA_CONTACT_TO="alondramusicacademy@gmail.com"

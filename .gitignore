# Dependencias y builds
node_modules/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# Secretos: un fichero por perfil, junto al compose (web/.env.dev, web/.env.prod).
# Los envs NO-secreto del repo (puertos, nombres de contenedor) sí se versionan.
.env
.env.*
!.env.example
!envs/.env.dev
!envs/.env.prod

# Documentación interna de trabajo: briefs, dossiers, bios, documentos de
# estrategia. No es parte del sitio y no tiene por qué acabar en el servidor.
# Los originales viven en ../../_assets/<cliente>/
docs/

# Originales de imágenes: la pipeline (npm run images) genera los .webp de
# public/images/, que son los únicos ficheros servidos.
imagen-sources/
images-resources/
images-sources/
docs-sources/
*.docx
*.xlsx
*.pptx
*.HEIC
*.heic

# Herramientas de desarrollo (no van al servidor)
.impeccable/
.lovable/
.agents/
skills-lock.json
.claude/settings.local.json
# Skill de impeccable, instalada por proyecto con `npx impeccable install --project`.
# Son ~14 MB por repo, con un binario compilado por plataforma dentro: es herramienta
# de la máquina, no código del proyecto, y una vez en la historia de git no se va ni
# borrándola. Se reinstala con ese mismo comando en cada máquina donde haga falta.
.claude/skills/
.claude/agents/
.codex/

# Sistema operativo / editor
.DS_Store
*.log
logs/
*.local
.vscode/*
!.vscode/extensions.json
.idea

# Cloudflare Tunnel: credenciales del túnel (SECRETO). El config.yml SÍ se versiona.
web/cloudflared/*.json
web/cloudflared/*.pem
